{
  "name": "cloud-stalwart",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker reverse proxy for a LAN-hosted Stalwart (JMAP) mail server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "wrangler": "^4.0.0"
  }
}
